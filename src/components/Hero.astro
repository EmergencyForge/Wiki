---
import { LinkButton } from '@astrojs/starlight/components';
// The EmergencyForge anvil (amboss.webp from the website) drawn with ef_lib calls; inside the shape every
// character is code, the edges are dots. Regenerate the text file if the mark changes.
import anvil from '../assets/anvil.txt?raw';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
---

<section class="ef-hero">
	<pre class="ef-anvil" aria-hidden="true">{anvil}</pre>
	<div class="ef-hero-copy">
		<p class="ef-prompt" aria-hidden="true">
			<span class="sign">$</span> open docs.emergencyforge.de<span class="cursor"></span>
		</p>
		<h1 id="_top" data-page-title set:html={title} />
		{tagline && <p class="tagline" set:html={tagline} />}
		<button type="button" class="ef-hero-search" data-ef-open-search>
			<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
				<path
					fill="currentColor"
					d="M10.5 4a6.5 6.5 0 0 1 5.18 10.43l4.45 4.44-1.42 1.42-4.44-4.45A6.5 6.5 0 1 1 10.5 4Zm0 2a4.5 4.5 0 1 0 0 9 4.5 4.5 0 0 0 0-9Z"
				></path>
			</svg>
			<span>Exports, Befehle oder Anleitungen suchen</span>
			<kbd>Strg K</kbd>
		</button>
		{
			actions.length > 0 && (
				<div class="actions">
					{actions.map(({ icon, link: href, text, variant }) => (
						<LinkButton {href} {variant} icon={icon?.name}>
							{text}
						</LinkButton>
					))}
				</div>
			)
		}
	</div>
</section>

<script>
	// The hero field is a second trigger for the search dialog in the header.
	document.querySelector('[data-ef-open-search]')?.addEventListener('click', () => {
		document.querySelector<HTMLElement>('header [data-open-modal]')?.click();
	});
	const kbd = document.querySelector('.ef-hero-search kbd');
	if (kbd && /Mac|iPhone|iPad/.test(navigator.platform)) kbd.textContent = '⌘ K';
</script>

<style>
	.ef-hero {
		position: relative;
		isolation: isolate;
		display: flex;
		align-items: center;
		min-height: clamp(22rem, 52vh, 34rem);
		padding-block: 2.5rem 3rem;
		/* On phones the anvil sits partly off-screen; without clipping the browser zooms out to fit it. */
		overflow-x: clip;
	}
	.ef-anvil {
		position: absolute;
		z-index: -1;
		inset-inline-end: 0;
		top: 50%;
		transform: translateY(-50%);
		margin: 0;
		padding: 0;
		background: none;
		border: 0;
		overflow: visible;
		font-family: var(--sl-font-mono);
		font-size: clamp(5px, 0.6vw, 8.5px);
		line-height: 1.2;
		letter-spacing: 0.02em;
		white-space: pre;
		user-select: none;
		pointer-events: none;
		/* A slow light passing over the code, like a cursor sweeping the forge. */
		color: transparent;
		background-image: linear-gradient(
			100deg,
			rgb(255 77 0 / 0.5) 35%,
			rgb(255 150 90 / 0.95) 50%,
			rgb(255 77 0 / 0.5) 65%
		);
		background-size: 300% 100%;
		background-position: 100% 0;
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 20%);
		mask-image: linear-gradient(90deg, transparent 0%, #000 20%);
		animation: ef-sweep 9s linear infinite;
	}
	:global(:root[data-theme='light']) .ef-anvil {
		background-image: linear-gradient(
			100deg,
			rgb(194 58 0 / 0.28) 35%,
			rgb(194 58 0 / 0.75) 50%,
			rgb(194 58 0 / 0.28) 65%
		);
	}
	@keyframes ef-sweep {
		to {
			background-position: -50% 0;
		}
	}

	.ef-hero-copy {
		max-width: 34rem;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}
	.ef-prompt {
		margin: 0;
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.ef-prompt .sign {
		color: var(--sl-color-text-accent);
	}
	.cursor {
		display: inline-block;
		width: 0.55em;
		height: 1.1em;
		margin-inline-start: 0.2em;
		vertical-align: text-bottom;
		background: var(--sl-color-text-accent);
		animation: ef-blink 1.1s steps(1) infinite;
	}
	@keyframes ef-blink {
		50% {
			opacity: 0;
		}
	}
	h1 {
		margin: 0;
		font-size: clamp(2.25rem, 5vw, 3.5rem);
		font-weight: 700;
		line-height: 1.05;
		letter-spacing: -0.03em;
		color: var(--sl-color-white);
	}
	.tagline {
		margin: 0;
		font-size: var(--sl-text-lg);
		line-height: 1.55;
		color: var(--sl-color-gray-2);
	}
	.ef-hero-search {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		width: 100%;
		max-width: 30rem;
		height: 3rem;
		padding: 0 0.625rem 0 1rem;
		font: inherit;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
		background: var(--ef-surface);
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: var(--ef-r-lg);
		cursor: pointer;
		text-align: start;
	}
	.ef-hero-search:hover {
		border-color: var(--sl-color-gray-4);
		color: var(--sl-color-gray-2);
	}
	.ef-hero-search:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}
	.ef-hero-search span {
		flex: 1;
		min-width: 0;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	kbd {
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-xs);
		padding: 0.2rem 0.45rem;
		border-radius: var(--ef-r-md);
		border: 1px solid var(--sl-color-hairline-light);
		background: var(--sl-color-bg);
		color: var(--sl-color-gray-3);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.25rem;
		align-items: center;
	}

	@media (max-width: 50rem) {
		.ef-hero {
			min-height: 0;
			padding-block: 1rem 2rem;
		}
		.ef-anvil {
			inset-inline-end: -40%;
			top: 2rem;
			transform: none;
			font-size: 5px;
			opacity: 0.55;
		}
		kbd {
			display: none;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.ef-anvil,
		.cursor {
			animation: none;
		}
	}
</style>
