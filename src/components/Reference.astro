---
import { getCollection } from 'astro:content';
import { Code } from '@astrojs/starlight/components';
import { byKindAndName } from '../content.config';

interface Props {
	/** File name in src/data/reference/ without extension, e.g. `ef-lib`. */
	resource: string;
	category: string;
}

const { resource, category } = Astro.props;
const resourceName = resource.replaceAll('-', '_');
const entries = (await getCollection(`reference-${resource}` as any))
	.filter((e: any) => e.data.category === category)
	.sort(byKindAndName) as any[];

const realmLabel = { client: 'Client', server: 'Server', shared: 'Shared' } as const;

// Descriptions are plain text with `code`, **bold** and [links](/x/); nothing else is rendered.
const inline = (text: string) =>
	text
		.replace(/&/g, '&amp;')
		.replace(/</g, '&lt;')
		.replace(/>/g, '&gt;')
		.replace(/`([^`]+)`/g, '<code>$1</code>')
		.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
		.replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, '<a href="$2">$1</a>');

function signature(d: any) {
	const args = d.params.map((p: any) => p.name);
	if (d.kind === 'event') {
		const name = `'${d.name}'`;
		if (d.usage === 'listen') return `AddEventHandler(${name}, function(${args.join(', ')})\nend)`;
		if (d.realm === 'client') return `TriggerClientEvent(${[name, 'target', ...args].join(', ')})`;
		if (d.realm === 'server') return `TriggerServerEvent(${[name, ...args].join(', ')})`;
		return `TriggerEvent(${[name, ...args].join(', ')})`;
	}
	const call = `exports.${resourceName}:${d.name}(${args.join(', ')})`;
	if (!d.returns.length) return call;
	const names = d.returns.map((r: any, i: number) => r.name ?? (d.returns.length > 1 ? `value${i + 1}` : 'result'));
	return `local ${names.join(', ')} = ${call}`;
}
---

<div class="ref-list not-content" data-category={category}>
	{
		entries.map(({ id, data: d }) => (
			<details
				class="ref-entry"
				id={id}
				data-realm={d.realm}
				data-kind={d.kind}
				data-search={[d.name, d.description, ...d.params.map((p: any) => p.name)].join(' ').toLowerCase()}
			>
				<summary>
					<span class="ref-name">{d.name}</span>
					<span class="ref-args">({d.params.map((p: any) => p.name).join(', ')})</span>
					<span class="ref-badges">
						{d.kind === 'event' && <span class="ef-badge event">Event</span>}
						<span class:list={['ef-badge', d.realm]}>{realmLabel[d.realm as keyof typeof realmLabel]}</span>
					</span>
				</summary>
				<div class="ref-body">
					<p class="ref-desc" set:html={inline(d.description)} />
					<Code code={signature(d)} lang="lua" wrap />

					{d.params.length > 0 && (
						<>
							<div class="ref-label">Parameter</div>
							<table>
								<tbody>
									{d.params.map((p: any) => (
										<tr>
											<td>
												<code>{p.name}</code>
												{p.optional && <span class="ref-opt">optional</span>}
											</td>
											<td>
												<code class="ref-type">{p.type}</code>
											</td>
											<td set:html={inline(p.description ?? '')} />
										</tr>
									))}
								</tbody>
							</table>
						</>
					)}

					{d.returns.length > 0 && (
						<>
							<div class="ref-label">Rückgabe</div>
							<table>
								<tbody>
									{d.returns.map((r: any) => (
										<tr>
											<td>{r.name ? <code>{r.name}</code> : null}</td>
											<td>
												<code class="ref-type">{r.type}</code>
											</td>
											<td set:html={inline(r.description ?? '')} />
										</tr>
									))}
								</tbody>
							</table>
						</>
					)}

					{d.example && (
						<>
							<div class="ref-label">Beispiel</div>
							<Code code={d.example.trimEnd()} lang="lua" />
						</>
					)}

					<div class="ref-links">
						<a href={`#${id}`} class="ref-permalink">Link zu {d.name}</a>
						{d.guide && <a href={d.guide}>Zur Anleitung</a>}
					</div>
				</div>
			</details>
		))
	}
</div>

<style>
	.ref-list {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		margin-top: 1rem;
	}
	.ref-entry {
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: var(--ef-r-2xl);
		background: var(--ef-surface);
		scroll-margin-top: calc(var(--sl-nav-height) + 4.5rem);
	}
	.ref-entry[open] {
		border-color: var(--sl-color-gray-4);
	}
	.ref-entry:target {
		border-color: var(--sl-color-accent);
	}
	summary {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		padding: 0.625rem 0.875rem;
		cursor: pointer;
		list-style: none;
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-sm);
	}
	summary::-webkit-details-marker {
		display: none;
	}
	summary:hover .ref-name {
		color: var(--sl-color-text-accent);
	}
	.ref-name {
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.ref-args {
		color: var(--sl-color-gray-3);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		min-width: 0;
	}
	.ref-badges {
		margin-inline-start: auto;
		display: flex;
		gap: 0.375rem;
		flex-shrink: 0;
	}
	.ref-body {
		padding: 0.25rem 0.875rem 0.875rem;
		border-top: 1px solid var(--sl-color-hairline);
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}
	.ref-desc {
		margin: 0.5rem 0 0;
		color: var(--sl-color-gray-1);
		line-height: 1.6;
	}
	.ref-label {
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--sl-color-gray-3);
		margin-bottom: -0.375rem;
	}
	table {
		width: 100%;
		border-collapse: collapse;
		font-size: var(--sl-text-sm);
	}
	td {
		padding: 0.4rem 0.75rem 0.4rem 0;
		border-top: 1px solid var(--sl-color-hairline);
		vertical-align: top;
		color: var(--sl-color-gray-2);
	}
	tr:first-child td {
		border-top: 0;
	}
	td:first-child,
	td:nth-child(2) {
		white-space: nowrap;
		width: 1%;
	}
	code {
		font-family: var(--sl-font-mono);
		font-size: 0.875em;
		padding: 0.05em 0.35em;
		border-radius: var(--ef-r-sm);
		background: var(--sl-color-bg-inline-code);
		color: var(--sl-color-white);
	}
	.ref-type {
		background: none;
		padding: 0;
		color: var(--sl-color-text-accent);
	}
	.ref-opt {
		display: block;
		font-size: 0.6875rem;
		color: var(--sl-color-gray-3);
		margin-top: 0.125rem;
	}
	.ref-body a {
		color: var(--sl-color-text-accent);
		text-decoration: none;
	}
	.ref-body a:hover {
		text-decoration: underline;
	}
	.ref-links {
		display: flex;
		gap: 1.25rem;
		font-size: var(--sl-text-sm);
	}
</style>
