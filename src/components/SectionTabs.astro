---
import { currentSection, sections } from '../sections';

interface Props {
	/** `header` shows from 50rem up, `menu` (inside the mobile sidebar) below that. */
	placement: 'header' | 'menu';
}

const current = currentSection(Astro.url.pathname);
---

<nav class:list={['section-tabs', 'print:hidden', Astro.props.placement]} aria-label="Bereiche">
	{
		sections.map((s) => (
			<a href={s.href} aria-current={s === current ? 'page' : undefined}>
				{s.label}
			</a>
		))
	}
</nav>

<style>
	.section-tabs {
		display: none;
	}
	a {
		text-decoration: none;
		font-size: var(--sl-text-sm);
		font-weight: 500;
		white-space: nowrap;
		color: var(--sl-color-gray-3);
	}
	a:hover,
	a[aria-current='page'] {
		color: var(--sl-color-white);
	}

	@media (min-width: 50rem) {
		.header {
			display: flex;
			gap: 0.25rem;
			align-self: stretch;
			/* The active bar sits on the header's bottom border. */
			margin-block: calc(-1 * var(--sl-nav-pad-y)) calc(-1 * var(--sl-nav-pad-y) - 1px);
		}
		.header a {
			display: flex;
			align-items: center;
			padding: 0 0.75rem;
			border-block: 2px solid transparent;
		}
		.header a[aria-current='page'] {
			border-bottom-color: var(--sl-color-accent);
		}
	}

	@media (max-width: 49.99rem) {
		.menu {
			display: flex;
			flex-wrap: wrap;
			gap: 0.375rem;
			/* Rendered outside the sidebar's padded list, so it brings its own inset. */
			padding: 1rem var(--sl-sidebar-pad-x, 1rem);
			margin-bottom: 1rem;
			border-bottom: 1px solid var(--sl-color-hairline);
		}
		.menu a {
			padding: 0.375rem 0.75rem;
			border: 1px solid var(--sl-color-hairline-light);
			border-radius: var(--ef-r-lg);
		}
		.menu a[aria-current='page'] {
			border-color: var(--sl-color-accent);
			background: var(--sl-color-accent-low);
		}
	}
</style>
