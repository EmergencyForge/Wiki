---
import { categorySlug, referenceResources } from '../content.config';
import Reference from './Reference.astro';

interface Props {
	resource: string;
}

const { resource } = Astro.props;
const categories = Object.entries(referenceResources[resource].categories);
---

{
	categories.map(([id, label]) => (
		<>
			<h2 id={categorySlug(label)}>{label}</h2>
			<Reference resource={resource} category={id} />
		</>
	))
}
